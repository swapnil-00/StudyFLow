# StudyFlow Environment Variables Template
# Copy this to .env and fill in the values.

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD_HERE@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Authentication (REQUIRED — app will refuse to start without this) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# MUST be different for production and preview. At least 32 bytes.
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES

# ── WhatsApp Cloud API (optional — messaging will return 503 if not set) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Encryption key for tenant provider credentials (Phase 7) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# ── Test database (REQUIRED for running tests — must NOT equal DATABASE_URL) ──
TEST_DATABASE_URL=

# ── Server ──────────────────────────────────────────────────────
PORT=5173
NODE_ENV=development
