# StudyFlow Environment Variables Template
# Copy this to .env and fill in the values.

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD_HERE@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Authentication (REQUIRED — app will refuse to start without this) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# MUST be different for production and preview. At least 32 bytes.
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES

# ── Encryption key for tenant provider credentials (Phase 7) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# ── Firebase Authentication (Server-side ID token verification) ──
# Service account credentials downloaded from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ── Allowed Origins & App URL ───────────────────────────────────
APP_ORIGIN=https://studyflow.in
APP_URL=https://studyflow.in
ALLOWED_ORIGINS=https://studyflow.in,https://app.studyflow.in

# ── Test database (REQUIRED for running tests — must NOT equal DATABASE_URL) ──
TEST_DATABASE_URL=

# ── Server ──────────────────────────────────────────────────────
PORT=5173
NODE_ENV=development


# ── Transactional email (password reset codes & security notices) ──
# Option A (no domain needed): Gmail SMTP with a Gmail App Password; @ in the address is written %40
# SMTP_URL=smtps://yourgmail%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# MAIL_FROM="StudyFlow <yourgmail@gmail.com>"
# Option B (own domain): key from https://resend.com → API Keys; MAIL_FROM on a domain verified in Resend
RESEND_API_KEY=
MAIL_FROM="StudyFlow <no-reply@yourdomain.com>"
# Optional: force a provider (resend | smtp). By default a free-mailbox MAIL_FROM (gmail.com…) uses SMTP.
# EMAIL_PROVIDER=
