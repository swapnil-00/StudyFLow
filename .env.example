# StudyFlow Environment Variables
# For Cloudflare Workers: secrets go in .dev.vars (local) or `wrangler secret put` (production).
# For local Node.js scripts (migrate, seed): copy this to .env.

# ── Database ────────────────────────────────────────────────────
# Used by local scripts. On Workers, Hyperdrive provides the connection.
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD_HERE@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Authentication (REQUIRED — app will refuse to start without this) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# MUST be the same value as on the previous (Vercel) deployment. At least 32 bytes.
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES

# ── Encryption key for tenant provider credentials ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be the same value as on the previous deployment, or encrypted settings break.
CREDENTIALS_ENCRYPTION_KEY=

# ── Firebase Authentication (Token verification only — no Admin SDK needed) ──
# Only the project ID is required. jose verifies tokens against Google's public JWKS.
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Allowed Origins & App URL ───────────────────────────────────
# Set to your new domain. Add the *.workers.dev URL during testing.
APP_ORIGIN=https://studyflow.in
APP_URL=https://studyflow.in
ALLOWED_ORIGINS=https://studyflow.in,https://app.studyflow.in

# ── Server (for local dev only) ──────────────────────────────────
PORT=5173
NODE_ENV=development

# ── Payments: Cashfree (plans + automatic-notification add-on) ──
# Cashfree dashboard → Developers → API Keys. Use the sandbox keys until KYC is complete.
# Webhook (PG, version 2023-08-01) must point at  <APP_URL>/api/webhooks/cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox              # sandbox | production
# CASHFREE_API_VERSION=2023-08-01

# ── Automatic WhatsApp reminders: Meta WhatsApp Cloud API (StudyFlow's own number) ──
# ON HOLD: the add-on is hidden and cannot be bought until AUTO_NOTIFY_ENABLED=true.
AUTO_NOTIFY_ENABLED=false
# Meta Business Manager → WhatsApp → API setup. Templates must be approved under these names.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TPL_PAYMENT_DUE=sf_payment_due
# WHATSAPP_TPL_PAYMENT_OVERDUE=sf_payment_overdue
# WHATSAPP_TPL_MEMBERSHIP_EXPIRING=sf_membership_expiring
# WHATSAPP_TPL_LANG=en

# ── Platform owner (Developer Lab: all libraries, plan changes, coupons) ──
# Comma-separated Google emails. Defaults to the platform owner in lib/platform-admin.js.
# PLATFORM_ADMIN_EMAILS=srchaudhari324@gmail.com

# ── Invoice / receipt verification codes (lib/invoices.js) ──
# Optional separate key; defaults to a key derived from JWT_SECRET. Changing it invalidates
# the codes on documents already issued, so set it once.
# INVOICE_SIGNING_KEY=

# ── Contact details shown on "Book a demo / Contact us" and the public policy pages ──
CONTACT_EMAIL=studyflowbusiness0@gmail.com
# CONTACT_WHATSAPP=919876543210
# CONTACT_ADDRESS=City, State, India
# BUSINESS_NAME=StudyFlow
# BUSINESS_OWNER=Swapnil Chaudhari

# ── Transactional email (password reset codes & security notices) ──
# On Cloudflare Workers, only HTTP-based email providers work (no SMTP).
# Recommended: verify your domain in Resend and add DNS records in Cloudflare.
RESEND_API_KEY=
MAIL_FROM="StudyFlow <no-reply@yourdomain.com>"
