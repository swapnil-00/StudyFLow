# StudyFlow Environment Variables
# For Cloudflare Workers: secrets go in .dev.vars (local) or `wrangler secret put` (production).
# For local Node.js scripts (migrate, seed): copy this to .env.

# ── Database ────────────────────────────────────────────────────
# Used by local scripts. On Workers, Hyperdrive provides the connection.
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD_HERE@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Authentication (REQUIRED — app will refuse to start without this) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# MUST be the same value as on the previous (Vercel) deployment. At least 32 bytes.
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES

# ── Encryption key for tenant provider credentials ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be the same value as on the previous deployment, or encrypted settings break.
CREDENTIALS_ENCRYPTION_KEY=

# ── Firebase Authentication (Token verification only — no Admin SDK needed) ──
# Only the project ID is required. jose verifies tokens against Google's public JWKS.
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Allowed Origins & App URL ───────────────────────────────────
# Set to your new domain. Add the *.workers.dev URL during testing.
APP_ORIGIN=https://studyflow.in
APP_URL=https://studyflow.in
ALLOWED_ORIGINS=https://studyflow.in,https://app.studyflow.in

# ── Server (for local dev only) ──────────────────────────────────
PORT=5173
NODE_ENV=development

# ── Transactional email (password reset codes & security notices) ──
# On Cloudflare Workers, only HTTP-based email providers work (no SMTP).
# Recommended: verify your domain in Resend and add DNS records in Cloudflare.
RESEND_API_KEY=
MAIL_FROM="StudyFlow <no-reply@yourdomain.com>"
